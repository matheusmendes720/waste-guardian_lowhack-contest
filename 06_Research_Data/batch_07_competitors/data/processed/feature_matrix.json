    "gamification": "Sistema de pontos, ranking, badges ou missões para engajar usuario",
    "donation_marketplace": "Marketplace para doar/vender excedentes a ONGs ou individuos",
    "social_ranking": "Leaderboard publico ou feed social de impacto",
    "household_focus": "Foco principal no desperdicio DOMESTICO (nao B2B/retail)",
    "b2b_analytics": "Dashboards de metricas para empresas parceiras",
    "iot_integration": "Integracao com geladeiras/balancas smart ou sensores",
    "offline_mode": "Funciona sem conexao (cache local)",
    "expiry_tracking": "Tracking automatico de data de validade",
    "shopping_list": "Lista de compras inteligente",
    "pantry_inventory": "Inventario digital de despensa/geladeira",
    "donation_logistics": "Logistica de coleta/entrega de doacoes",
    "brazilian_payment": "Aceita Pix ou vale-refeicao (BR-specific)",
    "esg_reporting": "Relatorios ESG auditaveis para empresas",
    "carbon_calculator": "Calculadora de CO2 evitado",
    "preserves_business_model": "Preserva receita do comercio (NAO doar/destruir)",
    "multi_country": "Opera em mais de 5 paises",
    "b_corp_certified": "Certificada B-Corp",
    "ai_consumption_prediction": "IA que PREVE consumo e sugere compras"
  },
